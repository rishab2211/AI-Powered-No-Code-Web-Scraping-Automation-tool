# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL recommended for production, e.g. Neon/Supabase/Railway)
# PostgreSQL: "postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# SQLite (Local Dev): "file:./dev.db"
DATABASE_URL="file:./dev.db"

# Authentication & Security Secrets (Generate secure 32+ character strings)
JWT_SECRET="your_jwt_secret_key_minimum_32_characters_here"
ENCRYPTION_SECRET_KEY="your_64_hex_character_32_byte_aes_encryption_secret_key"
API_SECRET="your_internal_api_secret_key_here"

# Google Gemini AI Integration (Required for AI extraction nodes)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Stripe Billing & Payments
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Puppeteer Headless Browser Automation (Docker / Linux Server)
# Set to /usr/bin/chromium in container environments
PUPPETEER_EXECUTABLE_PATH=""
PUPPETEER_HEADLESS="true"
