# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (Default: SQLite; supports PostgreSQL / MySQL via Prisma)
DATABASE_URL="file:./dev.db"

# Authentication & Security Secrets (Generate secure 32+ character strings)
JWT_SECRET="your_jwt_secret_key_minimum_32_characters_here"
ENCRYPTION_SECRET_KEY="your_32_byte_aes_encryption_secret_key"
API_SECRET="your_internal_api_secret_key_here"

# Google Gemini AI Integration (Required for AI extraction nodes)
GEMINI_API_KEY="your_google_gemini_api_key_here"
